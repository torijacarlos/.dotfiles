#!/bin/bash

function create_tmux_session {
    tmux new-session -ds tca-work -c ~/develop/torija/atlr -n atlr;
    tmux new-window -t tca-work -c ~/develop/torija/atlr -n tools;
    tmux new-session -ds tca-extra -n atlr
    tmux new-window -t tca-extra -c ~/.dotfiles -n dotfiles;

    tmux send-keys -t tca-work:atlr "v" Enter
    tmux send-keys -t tca-work:notes "v" Enter

    tmux send-keys -t tca-extra:atlr "atlrbg -d ~/drive/digitalart/illustration -t 300" Enter
    tmux send-keys -t tca-extra:dotfiles "v" Enter
}


if ! tmux has-session -t=tca-work 2> /dev/null; then
    echo "Creating session for tca-work"
    create_tmux_session
fi

tmux attach-session -t tca-work
