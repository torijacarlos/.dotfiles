#!/bin/bash

FOLDER=~/kura/code
DEPTH=1

selected=$(find $FOLDER -mindepth $DEPTH -maxdepth $DEPTH -type d | fzf)

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)


function create_tmux_session {
    tmux new-session -ds $selected_name -c $selected -n atlr;
    tmux send-keys -t $selected_name:atlr "v" Enter
    tmux new-window -t $selected_name -c $selected -n tools;
    tmux select-window -t $selected_name:atlr
}


if ! tmux has-session -t=$selected_name 2> /dev/null; then
    echo "Creating session for $selected_name [Press any key]"
    read
    create_tmux_session
fi

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    echo "Session for $selected_name was created or already existed"
else
    tmux attach -t $selected_name
fi

