{
    "position": "bottom",
    "height": 35,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 0,
    "margin": 0,
    "padding": 0,

    "modules-left": ["hyprland/workspaces", "memory", "cpu", "pulseaudio", "backlight"],
    "modules-right": ["network", "battery", "temperature", "bluetooth", "custom/vault", "clock#date", "clock"],

    "custom/vault": {
        "exec": "~/.local/bin/vault-status",
        "return-type": "json",
        "interval": 300
    },

    "hyprland/workspaces": {
        "show-special": true,
        "active-only": true,
        "disable-scroll": false,
        "persistent-workspaces": {
             "*": [1, 2, 3]
        },
        "tooltip": false,
    },

    "memory": {
        "format": "{}% ",
        "tooltip": false,
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false,
    },
    "pulseaudio": {
        "scroll-step": 5, // %, can be a float
        "tooltip": false,
        "format": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", ""]
        }
    },
    "backlight": {
        "tooltip": false,
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "sway/scratchpad": {
        "format": "{icon}    {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}"
    },


    "network": {
        "tooltip": true,
        "tooltip-format": "{essid} {ifname} ({ipaddr})",
        "format-wifi": "⬆️ {bandwidthUpBits} - {bandwidthDownBits} ⬇️ | {signalStrength}% ",
        "format-disconnected": "Disconnected ⚠",
    },
    "battery": {
        "states": {
            "warning": 50,
            "critical": 20
        },
        "format": "{capacity}% {icon}",
        "format-alt": "{time} {icon}",
        "format-full": "{icon}",
        "format-icons": ["", "", "", "", ""],
        "tooltip": false,
    },
    "temperature": {
        "hwmon-by-name": "k10temp",
        "input-filename": "temp1_input",
        "critical-threshold": 70,
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""],
        "tooltip": false,
    },
    "bluetooth": {
        "format": "",
        "format-connected-battery": "{device_battery_percentage}% "
    },
    "clock#date": {
        "timezone": "America/Mexico_City",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "  {:%d %b, %Y}"
    },

    "clock": {
        "timezone": "America/Mexico_City",
        "tooltip": false,
    },
}
